.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Reader-mode output directories from /paper-trail runs (contain fetched PDFs
# and audit artifacts scoped to a specific input paper; not shareable repo content).
# Anchored to repo root so curated examples under examples/paper-trail-*/ are not excluded.
/paper-trail-*/

# Experiments are tracked on main since the Sarol isolation work landed (2026-09-30). The
# earlier blanket `/experiments/` rule from when experiments lived only on side branches is
# gone, because it silently drops every NEW file under experiments/. Their generated
# artifacts are ignored by the narrower rules below.

# Machine-local Claude Code state (per-user permissions, background-session
# worktrees). Content-bearing .claude/<dir>/ entries are tracked symlinks into
# src/ (the canonical ship surface); settings.local.json stays canonical at
# .claude/ root and never ships.
.claude/settings.local.json
.claude/worktrees/

# Skills (shipped surface) — explicit carveout list; everything else under
# src/skills/ stays local-only so auto-installed or local-experiment skills
# don't accidentally ship.
# NOTE: `src/skills/*` not `src/skills/` — the former lets `!` exceptions
# re-include specific entries; the latter ignores the directory entirely and
# `!` cannot re-include anything inside it (per git ignore rules).
src/skills/*
!src/skills/doc-split-check.md
!src/skills/plan-check.md
!src/skills/paperclip/
src/scripts/__pycache__/
*.pyc

# External benchmark datasets (fetched on demand; see data/benchmarks/*/download.sh).
# Bulk data is not committed; download scripts and READMEs are.
# NOTE: `/dir/*/` ignores the directory entirely and prevents re-include via `!`.
# Ignore contents-not-dir so re-includes work.
/data/benchmarks/*/*
!/data/benchmarks/*/download.sh
!/data/benchmarks/*/README.md

# Adapter-generated predictions, staged handles, and gold files (regeneratable).
# Gold is especially important to exclude — it must never end up in reproducible
# artifacts under source control without review.
/experiments/*/predictions/
/experiments/*/staging/
/experiments/*/gold/

# Secrets — env files that may hold API keys, OAuth tokens, GCP credentials, etc.
# Reproducibility is achieved via committed invocation shape + each reproducer
# supplying their own auth; the secret values themselves MUST NOT enter version
# control. Template files (.env.example) are allowed so the expected variables
# are documented.
.env
.env.local
.env.*
!.env.example

# Service-account JSON keys (e.g., GCP). Generally stored outside the repo, but
# belt-and-suspenders in case someone drops one under the tree.
*-service-account*.json
gcp-credentials*.json

# Per-session resume state written by /wrapup. Working notes for the next agent, not a
# historical record: they name in-flight branches, blockers and open questions, and go stale
# the moment the work moves.
docs/session/

# Per-iteration release payloads. The engine's `loop_ops` writes `iter/<n>/release_{train,val}.json`
# under the repo root, because the repo root is the optimizer's cwd and that is where
# `optimizer/context/release-format.md` tells it to look. Run state, rewritten every run — the
# durable record of a run's numbers is the run root under ~/.paper-trail/runs/, not this.
/iter/

# Canary staging and the throwaway one-claim batch used to MEASURE a pin. The pin itself
# (`canary-<profile>.json`) IS committed: it is the recorded observation the guard compares
# against, and a guard whose reference value is not under version control is not a guard.
/experiments/sarol-2024/optimizer/canary/staging/
/experiments/sarol-2024/optimizer/canary/pin-batch-*.json
.explain-plan/

# Plan docs, reviewer output and rendered explainers. These are authored on the shared
# mount (planning/paper-trail/), which is inside the secure environment, so they cost no
# document review there. `docs/plans` is a symlink to that folder.
docs/plans
